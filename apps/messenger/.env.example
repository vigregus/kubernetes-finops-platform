# =============================================================================
# Пример локальной конфигурации для запуска messenger-api и воркеров на хосте
# Скопируйте в .env (он в .gitignore) и при необходимости скорректируйте значения:
#   cp apps/messenger/.env.example apps/messenger/.env
# =============================================================================

# --- Базовые параметры сервиса ---
SERVICE_NAME=messenger-api
SERVICE_VERSION=local-dev
ENVIRONMENT=local
LOG_LEVEL=DEBUG
HOSTNAME=localhost

# --- База данных (Postgres / PgBouncer) ---
# Для подключения с хоста выполните:
#   kubectl -n messenger port-forward svc/messenger-db-pool 5432:5432
# Пароль можно узнать командой:
#   kubectl -n messenger get secret messenger-db-app -o jsonpath='{.data.password}' | base64 -d
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=messenger
DATABASE_USER=messenger
DATABASE_PASSWORD=replace-with-local-db-password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Redis (App-cache и Security/Rate-limiting) ---
# Для подключения с хоста:
#   kubectl -n messenger port-forward svc/messenger-redis 6379:6379
# БД 1 - кеш приложения, БД 2 - счетчики rate-limiting
REDIS_URL=redis://localhost:6379/1
REDIS_SECURITY_URL=redis://localhost:6379/2

# --- Kafka (для outbox_relay и консьюмеров) ---
# Для подключения с хоста:
#   kubectl -n kafka port-forward svc/messenger-kafka-kafka-bootstrap 9092:9092
# Пароль для роли messenger-outbox:
#   kubectl -n messenger get secret messenger-outbox -o jsonpath='{.data.password}' | base64 -d
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_USERNAME=messenger-outbox
KAFKA_PASSWORD=replace-with-kafka-password
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=60
OUTBOX_IDLE_SLEEP_SECONDS=0.5
METRICS_PORT=9100

# --- Keycloak & OIDC ---
# Для работы с Keycloak с хоста:
#   kubectl -n keycloak port-forward svc/messenger-idp-service 8080:8080
# Добавьте в /etc/hosts: 127.0.0.1 idp.finops.local app.finops.local
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=messenger
OIDC_ISSUER=https://idp.finops.local/realms/messenger
OIDC_JWKS_URL=http://localhost:8080/realms/messenger/protocol/openid-connect/certs
OIDC_TOKEN_URL=http://localhost:8080/realms/messenger/protocol/openid-connect/token
OIDC_AUDIENCE=messenger-api
OIDC_CLIENT_ID=messenger-web
OIDC_BACKCHANNEL_AUDIENCE=messenger-web

# Секрет сервисной учетной записи API для Admin REST API (верификация почты и т.д.):
#   kubectl -n messenger get secret messenger-api-client -o jsonpath='{.data.client-secret}' | base64 -d
OIDC_CLIENT_SECRET=replace-with-keycloak-client-secret

# --- Centrifugo (Realtime WebSocket) ---
# Для подключения с хоста:
#   kubectl -n messenger port-forward svc/messenger-centrifugo 9000:9000
# Секреты Centrifugo:
#   kubectl -n messenger get secret messenger-centrifugo -o jsonpath='{.data.CENTRIFUGO_HTTP_API_KEY}' | base64 -d
#   kubectl -n messenger get secret messenger-centrifugo -o jsonpath='{.data.CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY}' | base64 -d
CENTRIFUGO_API_URL=http://localhost:9000/api
CENTRIFUGO_HTTP_API_KEY=replace-with-centrifugo-api-key
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=replace-with-centrifugo-hmac-key

# --- Web & Cookie settings ---
WEB_ORIGIN=https://app.finops.local
AUTH_COOKIE_NAME=messenger_refresh
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SECURE=false

# --- Телеметрия (OpenTelemetry OTLP) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0
