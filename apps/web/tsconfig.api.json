{
  // Сгенерированный клиент — отдельный проект, а не часть tsconfig.app.json.
  //
  // Это не послабление ради зелёной сборки, а признание факта: код в
  // src/api/generated/ писан не нами и не под наш tsconfig. Три правила
  // приложения он нарушает систематически, и каждое нарушение безвредно:
  //
  //   noUnusedLocals / noUnusedParameters — генератор импортирует в модель
  //     все соседние FromJSON/ToJSON и параметр ignoreDiscriminator, даже
  //     когда они не нужны. Это шум генератора, а не дефект контракта.
  //   erasableSyntaxOnly — runtime.ts объявляет поля через параметры
  //     конструктора (public readonly basePath). Правило введено ради
  //     стираемого синтаксиса нашего кода; править чужой шаблон ради него
  //     значило бы держать собственную копию шаблонов генератора.
  //
  // Поэтому здесь только те правила, которые generated/ действительно может
  // исполнить. Разделение проектов не отменяет проверку: клиент по-прежнему
  // проверяется типами — целиком, а не выборочно, — и его форма отдельно
  // утверждается в src/api/contract.test.ts, который живёт в проекте
  // приложения и типизирован по-настоящему. Отдельный проект нужен ровно для
  // того, чтобы ошибки этого файла не появлялись в сборке приложения: tsc
  // сообщает об ошибках импортируемого файла независимо от exclude, поэтому
  // "просто исключить каталог" задачу не решает.
  //
  // Ошибка в сгенерированном коде при этом не молчит: этот проект собирается
  // тем же `tsc -b`, и несуществующий тип в модели роняет сборку здесь.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "outDir": "./node_modules/.tmp/api-types",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    // composite + declaration: проект отдаёт наружу объявления, и приложение
    // видит типы клиента, не перепроверяя его исходники.
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,

    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/api/generated"]
}
